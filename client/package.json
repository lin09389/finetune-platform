{
  "name": "finetune-client",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:runtime": "vitest run src/test/RuntimeContext.test.tsx src/test/RuntimeWorkflows.test.tsx --reporter=basic",
    "test:agent-foundation": "vitest run src/test/AgentFrontendFoundation.test.tsx src/test/AgentWorkbenchRuntime.test.tsx src/test/AgentWorkspaceView.test.tsx src/test/Sidebar.test.tsx src/test/gaSmokePages.test.tsx --reporter=basic",
    "test:agent-e2e": "node scripts/verify-agent-workbench.mjs",
    "test:smoke": "vitest run src/test/Sidebar.test.tsx src/test/betaTierPages.test.tsx src/test/experimentalStatusPages.test.tsx src/test/gaSmokePages.test.tsx --reporter=basic",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:perf": "npm run build && lhci autorun",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.12.0",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "framer-motion": "^12.36.0",
    "highlight.js": "^11.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.0",
    "react-virtuoso": "^4.10.0",
    "recharts": "^3.7.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^10.3.5",
    "jsdom": "^23.0.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.9",
    "prettier": "^3.1.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
