# Finetune Platform 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ===========================================
# 服务器配置
# ===========================================
HOST=127.0.0.1
PORT=8000

# 运行环境: development / staging / production
# 生产环境会强制启用认证和安全检查
ENVIRONMENT=development

# ===========================================
# 安全配置 (生产环境必须配置)
# ===========================================
# 是否启用JWT认证 (生产环境强制启用)
ENABLE_AUTH=true

# JWT 密钥 (生产环境必须设置强随机密钥)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT 配置
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS 配置
# ===========================================
# 允许的前端来源，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# 速率限制
# ===========================================
# 每个时间窗口内的最大请求数
RATE_LIMIT=100

# 时间窗口大小 (秒)
RATE_WINDOW=60

# Redis 配置 (用于速率限制持久化，可选)
# 如果不配置，将使用内存存储
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Ollama 配置
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# HuggingFace 配置
# ===========================================
# 镜像源: official / hf-mirror / aliyun / modelscope
HF_MIRROR=hf-mirror

# 模型下载源: modelscope / huggingface
MODEL_SOURCE=modelscope

# ===========================================
# 代理配置 (可选)
# ===========================================
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ===========================================
# 训练配置
# ===========================================
# 最大并发训练数
MAX_CONCURRENT_TRAINING=1

# 启用检查点
ENABLE_CHECKPOINT=true

# 检查点间隔步数
CHECKPOINT_INTERVAL=500

# ===========================================
# 日志配置
# ===========================================
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志格式: text / json
LOG_FORMAT=text

# ===========================================
# 文件上传配置
# ===========================================
# 最大上传大小 (字节)
MAX_UPLOAD_SIZE=104857600

# 允许的文件类型
ALLOWED_FILE_TYPES=.json,.jsonl

# ===========================================
# 推理配置
# ===========================================
# 推理引擎: huggingface / vllm / llamacpp / ollama
INFERENCE_ENGINE=huggingface

# 启用 Flash Attention 加速
ENABLE_FLASH_ATTENTION=true

# ===========================================
# 性能配置
# ===========================================
# 启用动态批处理
ENABLE_BATCHING=false

# 最大批处理大小
MAX_BATCH_SIZE=8

# 批处理最大等待时间 (毫秒)
MAX_BATCH_WAIT_MS=50
