# Finetune Platform 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ============================================================
# 首次本地体验推荐（覆盖以下两项即可快速启动）
# ============================================================
# 注意：以下为本地开发推荐值；生产环境请见下方各分组的生产要求。
# 本地体验时将下面 [安全配置] 分组的 ENABLE_AUTH 改为 false、
# JWT_SECRET_KEY 留空（ENABLE_AUTH=false 时不校验），即可免登录联调 /agent。
# Agent 本机免 token 还需 ALLOW_LOCAL_AGENT_AUTH=true（见 AGENTS.md 本地用法矩阵）。

# ===========================================
# 服务器配置
# ===========================================
# 本地开发启动脚本使用 127.0.0.1:8010（start.bat / start-backend.bat）
# Docker 镜像和 docker-compose 内部默认使用 0.0.0.0:8000
# 本地开发统一 8010，与前端默认 API_BASE_URL 一致，无需修改
HOST=127.0.0.1
PORT=8010

# 运行环境: development / staging / production
# 生产环境会强制启用认证和安全检查
ENVIRONMENT=development

# ===========================================
# Agent 配置
# ===========================================
# Agent 默认项目路径（本地开发可设为绝对路径；留空则自动推断到仓库根目录）
AGENT_DEFAULT_PROJECT_PATH=

# ===========================================
# 安全配置 (生产环境必须配置)
# ===========================================
# 是否启用JWT认证 (生产环境强制启用)
# 本地体验可设 false 免登录联调；生产/staging 必须 true
ENABLE_AUTH=true

# JWT 密钥 (生产环境必须设置强随机密钥)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 本地体验 ENABLE_AUTH=false 时可留空；生产必须换强随机值
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT 配置
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS 配置
# ===========================================
# 允许的前端来源，多个用逗号分隔
# Docker 体验版默认前端端口也是 5173，请保留 localhost/127.0.0.1 两种来源
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# 速率限制
# ===========================================
# 每个时间窗口内的最大请求数
RATE_LIMIT=100

# 时间窗口大小 (秒)
RATE_WINDOW=60

# Redis 配置 (用于速率限制持久化，可选)
# 如果不配置，将使用内存存储
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Ollama 配置
# ===========================================
# 本地直接运行使用 http://localhost:11434
# Docker compose 内部服务互联使用 http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# 单用户本地体验默认开启快速模式，降低延迟和输出长度
OLLAMA_FAST_MODE=true
OLLAMA_FAST_MAX_TOKENS=128
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_STREAM_READ_TIMEOUT_SECONDS=120

# ===========================================
# Docker 持久化目录（容器内路径）
# ===========================================
# Docker 体验版会把宿主机 ./models ./datasets ./outputs ./logs ./data
# 分别挂载到容器内 /app/models /app/datasets /app/outputs /app/logs /app/data
# 本地直接运行通常不需要设置这些变量
# MODELS_DIR=/app/models
# DATASETS_DIR=/app/datasets
# OUTPUTS_DIR=/app/outputs
# HF_HOME=/app/models/huggingface
# SENTENCE_TRANSFORMERS_HOME=/app/models/sentence-transformers
# MODELSCOPE_CACHE_DIR=/app/models/modelscope_cache

# ===========================================
# HuggingFace 配置
# ===========================================
# 镜像源: official / hf-mirror / aliyun / modelscope
# 海外用户改为 official；中国大陆推荐 hf-mirror 或 modelscope
HF_MIRROR=hf-mirror

# 模型下载源: modelscope / huggingface
MODEL_SOURCE=modelscope

# ===========================================
# 代理配置 (可选)
# ===========================================
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ===========================================
# 训练配置
# ===========================================
# 最大并发训练数
MAX_CONCURRENT_TRAINING=1

# 启用检查点
ENABLE_CHECKPOINT=true

# 检查点间隔步数
CHECKPOINT_INTERVAL=500

# ===========================================
# 日志配置
# ===========================================
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志格式: text / json
LOG_FORMAT=text

# ===========================================
# 文件上传配置
# ===========================================
# 最大上传大小 (字节)
MAX_UPLOAD_SIZE=104857600

# 允许的文件类型
ALLOWED_FILE_TYPES=.json,.jsonl

# ===========================================
# 推理配置
# ===========================================
# 推理引擎: huggingface / vllm / llamacpp / ollama
# 本地已有 Ollama 服务时可改为 ollama
# 注意：start.bat 会单独启动 :8020 独立推理服务（inference_server），
# 此处 INFERENCE_ENGINE 控制的是后端直连引擎选择，与 :8020 服务协作
INFERENCE_ENGINE=huggingface

# 启用 Flash Attention 加速
# 如果环境未安装 flash-attn 或显卡不支持，可设为 false
ENABLE_FLASH_ATTENTION=true

# ===========================================
# 性能配置
# ===========================================
# 启用动态批处理
ENABLE_BATCHING=false

# 最大批处理大小
MAX_BATCH_SIZE=8

# 批处理最大等待时间 (毫秒)
MAX_BATCH_WAIT_MS=50
