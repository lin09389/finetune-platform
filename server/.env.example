# ========================================
# Finetune Platform 环境变量配置示例
# ========================================
# 复制此文件为 .env 并根据实际情况修改

# ----------------------------------------
# 服务配置
# ----------------------------------------
HOST=127.0.0.1
PORT=8000

# ----------------------------------------
# CORS 配置
# ----------------------------------------
# 逗号分隔的允许来源
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ----------------------------------------
# 速率限制
# ----------------------------------------
# 每分钟最大请求数
RATE_LIMIT=100
# 时间窗口（秒）
RATE_WINDOW=60

# ----------------------------------------
# 目录配置
# ----------------------------------------
# 如不设置，将自动使用项目根目录下的对应文件夹
# MODELS_DIR=./models
# DATASETS_DIR=./datasets
# OUTPUTS_DIR=./outputs

# ----------------------------------------
# Ollama 配置
# ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
INFERENCE_BACKEND=huggingface

# ----------------------------------------
# 日志配置
# ----------------------------------------
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志格式：text, json
LOG_FORMAT=text

# ----------------------------------------
# 安全配置（Phase-0：默认安全 + 显式本地通道）
# ----------------------------------------
# development | staging | production
# staging/production: JWT 必填、禁止默认推理密钥、禁止本地 agent 免登
ENVIRONMENT=development

# 是否启用 JWT 鉴权（生产/staging 必须 true）
ENABLE_AUTH=true

# JWT 密钥（必填；禁止依赖自动生成。本地可复制下面这一行）
JWT_SECRET_KEY=dev-only-local-secret-change-me

# 本地 Agent 免 token 联调（仅非 production/staging 生效；生产设 true 也无效）
# 需要本机方便测 /agent-sessions 时再打开
ALLOW_LOCAL_AGENT_AUTH=true

# 单次 Agent prompt/resume 墙钟超时（秒），超时后会话进入 needs_manual_review
# AGENT_SESSION_MAX_SECONDS=3600

# 方案 A：工具结果体积控制（DeepAgents 外置 + execute 截断）
# 工具结果约超过该 token 数 → 写入 /large_tool_results/ 并只给模型预览（默认 12000，DeepAgents 库默认 20000）
# AGENT_TOOL_TOKEN_LIMIT_BEFORE_EVICT=12000
# execute 捕获输出上限（字节，默认 200000）
# AGENT_EXECUTE_MAX_OUTPUT_BYTES=200000
# 时间线 part 中展示的工具结果最大字符（全文可在 VFS）
# AGENT_TOOL_RESULT_UI_MAX_CHARS=12000

# Agent execute 工具沙箱模式（仅 Windows 生效）：
#   local = 本机 cmd.exe 直接执行（默认）
#   wsl   = 在 WSL2 Linux bash 中执行（提供 Unix 工具链兼容，不是安全边界）
# 设为 wsl 需要已安装 WSL2 + 至少一个带 bash/coreutils 的 Linux 发行版。
# 默认发行版若是 docker-desktop，请显式指定 Ubuntu 等开发发行版：
# SANDBOX_WSL_DISTRIBUTION=Ubuntu
SANDBOX_EXECUTION_MODE=local

# 控制面 <-> 独立推理服务共享密钥
# 开发可用默认值；生产/staging 禁止使用 finetune-local-inference-dev-key
INFERENCE_INTERNAL_API_KEY=finetune-local-inference-dev-key

# 训练/推理 GPU 互斥协调（默认 on；仅非生产可设 off）
GPU_COORDINATION=on

# 实验能力（CUA/MCP/Gateway/Heartbeat/OCR）
# development 默认 true；production/staging 未显式设 true 时强制 false
# 启用后挂载 /experimental/*，并保留 /cua 等 legacy 别名
ENABLE_EXPERIMENTAL_CAPABILITIES=true

# 最大上传大小（字节）- 默认 100MB
MAX_UPLOAD_SIZE=104857600
# 允许的文件类型（逗号分隔）
ALLOWED_FILE_TYPES=.json,.jsonl

# ----------------------------------------
# 训练配置
# ----------------------------------------
# 最大并发训练数
MAX_CONCURRENT_TRAINING=1
# 启用检查点
ENABLE_CHECKPOINT=true
# 检查点间隔步数
CHECKPOINT_INTERVAL=500

# ----------------------------------------
# 调试模式（生产环境请设为 false）
# ----------------------------------------
DEBUG=true

# ----------------------------------------
# 本地测试矩阵（复制即用）
# ----------------------------------------
# 1) UI/联调：ENVIRONMENT=development ENABLE_AUTH=true JWT_SECRET_KEY=... ALLOW_LOCAL_AGENT_AUTH=true
# 2) 测 CUA：登录 ADMIN 账号后带 Authorization: Bearer <token>（DEBUG 不会放行 CUA）
# 3) pytest：conftest 已 setdefault JWT_SECRET_KEY / ALLOW_LOCAL_AGENT_AUTH / INFERENCE_INTERNAL_API_KEY
# 4) 生产：ENVIRONMENT=production ENABLE_AUTH=true 强随机 JWT + 非默认 INFERENCE_INTERNAL_API_KEY
#    且不要设置 ALLOW_LOCAL_AGENT_AUTH=true
