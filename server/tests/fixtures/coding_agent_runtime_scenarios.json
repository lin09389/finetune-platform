{
  "contract_version": 1,
  "runtime": {
    "model": "scripted-tool-calling-fake",
    "network": false,
    "cuda": false,
    "execution_loop": "deepagents"
  },
  "scenarios": [
    {
      "id": "python-single-file-fix",
      "kind": "python",
      "files": {
        "app.py": "def clamp(value: int) -> int:\n    return min(value, 10)\n",
        "test_app.py": "from app import clamp\n\ndef test_clamp_keeps_zero():\n    assert clamp(0) == 0\n"
      },
      "operations": ["read:app.py", "read:test_app.py", "edit:app.py", "execute:python -m py_compile app.py"],
      "expected_files": {"app.py": "def clamp(value: int) -> int:\n    return max(0, min(value, 10))\n"},
      "expected_diff_paths": ["app.py"],
      "verification_after_last_write": true
    },
    {
      "id": "react-typescript-change",
      "kind": "react_typescript",
      "files": {
        "client/src/StatusCard.tsx": "export const StatusCard = () => <span>idle</span>;\n",
        "client/src/StatusCard.test.tsx": "export {};\n"
      },
      "operations": ["read:client/src/StatusCard.tsx", "read:client/src/StatusCard.test.tsx", "edit:client/src/StatusCard.tsx", "execute:node -e status-card-check"],
      "expected_files": {"client/src/StatusCard.tsx": "export const StatusCard = () => <span role=\"status\">ready</span>;\n"},
      "expected_diff_paths": ["client/src/StatusCard.tsx"],
      "verification_after_last_write": true
    },
    {
      "id": "cross-stack-multi-file",
      "kind": "cross_stack",
      "files": {
        "server/tasks.py": "def task_payload():\n    return {'name': 'demo'}\n",
        "server/test_tasks.py": "from tasks import task_payload\n",
        "client/src/tasks.ts": "export type Task = { name: string };\n",
        "client/src/TaskList.tsx": "export const TaskList = () => null;\n"
      },
      "operations": ["read:server/tasks.py", "read:server/test_tasks.py", "read:client/src/tasks.ts", "read:client/src/TaskList.tsx", "edit:server/tasks.py", "edit:client/src/tasks.ts", "edit:client/src/TaskList.tsx", "execute:python -m py_compile server/tasks.py", "execute:node -e task-list-check"],
      "expected_files": {
        "server/tasks.py": "def task_payload():\n    return {'name': 'demo', 'status': 'ready'}\n",
        "client/src/tasks.ts": "export type Task = { name: string; status: 'ready' };\n",
        "client/src/TaskList.tsx": "export const TaskList = () => <span>ready</span>;\n"
      },
      "expected_diff_paths": ["client/src/TaskList.tsx", "client/src/tasks.ts", "server/tasks.py"],
      "verification_after_last_write": true
    },
    {
      "id": "failed-tool-reread-repair",
      "kind": "failure_recovery",
      "files": {
        "parser.py": "def parse(value: str) -> str:\n    return value.strip()\n",
        "test_parser.py": "from parser import parse\n"
      },
      "operations": ["read:parser.py", "read:test_parser.py", "edit:parser.py", "execute:forced failure", "read:parser.py", "edit:parser.py", "execute:python -m py_compile parser.py"],
      "expected_files": {"parser.py": "def parse(value: str) -> str:\n    return value.strip().lower()\n"},
      "expected_diff_paths": ["parser.py", "parser.py"],
      "verification_after_last_write": true
    },
    {
      "id": "refresh-reload-review",
      "kind": "refresh_reload",
      "files": {"src/main.py": "VALUE = 'before'\n"},
      "operations": ["read:src/main.py", "edit:src/main.py", "execute:python -m py_compile src/main.py"],
      "expected_files": {"src/main.py": "VALUE = 'after'\n"},
      "expected_diff_paths": ["src/main.py"],
      "verification_after_last_write": true
    },
    {
      "id": "workspace-escape-rejected",
      "kind": "path_isolation",
      "files": {"safe.py": "SAFE = True\n"},
      "operations": ["read:safe.py", "edit:../outside.py"],
      "expected_files": {"safe.py": "SAFE = True\n"},
      "expected_diff_paths": [],
      "verification_after_last_write": false
    }
  ]
}
